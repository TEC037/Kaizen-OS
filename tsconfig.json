{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/modules/gym/fitai/node_modules",
    "src/modules/gym/fitai/dist",
    "src/modules/gym/fitai/vite.config.ts",
    "src/modules/gym/fitai/src/**/*.test.ts",
    "src/modules/gym/fitai/src/**/*.test.tsx",
    "src/modules/gym/fitai/src/test",
    "src/modules/gym/fitai/functions/**/*.test.ts"
  ]
}
